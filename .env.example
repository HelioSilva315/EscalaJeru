VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON

# Nome exibido na interface (opcional)
VITE_CHURCH_NAME=Igreja JERU
