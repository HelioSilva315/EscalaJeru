# Segredos das Edge Functions do EscalaJeru
# NÃO comite este arquivo preenchido. Use `supabase secrets set` em produção.

# URL pública do app (usada nos links dos lembretes)
APP_URL=https://escalajeru.netlify.app
APP_ORIGIN=https://escalajeru.netlify.app

# Protege a chamada automática do cron
CRON_SECRET=troque-por-uma-string-longa-e-aleatoria

# WhatsApp — escolha UM provedor: cloud (Meta) ou zapi
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
